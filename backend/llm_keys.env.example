# Copy this file to backend/llm_keys.env and fill in your local API keys.
# backend/llm_keys.env is ignored by Git and should never be committed.

HOME_FLOW_LLM_ENABLED=true

# DeepSeek
# Uses LangChain's langchain-deepseek integration.
HOME_FLOW_LLM_PROVIDER=deepseek
HOME_FLOW_LLM_BASE_URL=https://api.deepseek.com
HOME_FLOW_LLM_MODEL=deepseek-chat
HOME_FLOW_LLM_API_KEY=

# Qwen OpenAI-compatible mode
# Uses LangChain's langchain-openai ChatOpenAI with base_url.
# HOME_FLOW_LLM_PROVIDER=qwen
# HOME_FLOW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# HOME_FLOW_LLM_MODEL=qwen-plus
# HOME_FLOW_LLM_API_KEY=

# GLM OpenAI-compatible mode
# Uses LangChain's langchain-openai ChatOpenAI with base_url.
# HOME_FLOW_LLM_PROVIDER=glm
# HOME_FLOW_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# HOME_FLOW_LLM_MODEL=glm-4.5-air
# HOME_FLOW_LLM_API_KEY=

# Tencent Cloud OCR fallback. Local OCR is tried first; Tencent OCR is called
# only when required order fields are still missing.
TENCENT_OCR_ID=
TENCENT_OCR_KEY=
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_ACTION=GeneralAccurateOCR
TENCENT_OCR_TIMEOUT_SECONDS=15
